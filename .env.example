# Help Scout: Profile → My apps → create OAuth app → Client credentials
HELPSCOUT_CLIENT_ID=
HELPSCOUT_CLIENT_SECRET=
# Optional: default inbox for listing / --pick-next (numeric id)
HELPSCOUT_MAILBOX_ID=

# Anthropic
ANTHROPIC_API_KEY=
# Optional; see https://docs.anthropic.com/en/docs/about-claude/models
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# After a draft is created, this tag is merged onto the conversation (empty = do not tag)
HELPSCOUT_DRAFT_TAG=ai-claude-draft

# When using --pick-next, skip conversations that already have this tag
HELPSCOUT_SKIP_IF_TAG=ai-claude-draft

# Webhook: must match the secret you configure on the webhook in Help Scout (Mailbox API)
HELPSCOUT_WEBHOOK_SECRET=
